SELECT
i.serial_number,i.activity_date,i.service_description,i.parent_company,
i,program_name,i.facility_city,i.size,i.risk_levle,i.score,i.grade,
v.serial_number as violation_serial, v.violation_description,v.points
FROM dbo.inspections_clean as i
LEFT JOIN dbo.violations_clean as v
ON i.serial_number=v.serial_number;
